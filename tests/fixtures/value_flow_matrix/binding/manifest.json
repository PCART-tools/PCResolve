{
  "version": 1,
  "cases": [
    {
      "id": "binding.positional_only",
      "category": "binding/positional",
      "module": "cases",
      "entry": "positional_only",
      "rationale": "The slash makes first and second positional-only. Argument 0 binds first, argument 1 binds second; only second is returned.",
      "max_depth": 3,
      "returns": {
        "x": false,
        "y": true
      },
      "calls": [
        {
          "name": "positional",
          "occurrence": 0,
          "target": "helpers:positional",
          "return_flow": true,
          "bindings": {
            "0": "first",
            "1": "second"
          },
          "flows": [
            [
              "x",
              "first",
              true
            ],
            [
              "x",
              "second",
              false
            ],
            [
              "y",
              "second",
              true
            ],
            [
              "y",
              "first",
              false
            ]
          ]
        }
      ]
    },
    {
      "id": "binding.keyword_only",
      "category": "binding/keyword",
      "module": "cases",
      "entry": "keyword_only",
      "rationale": "Keyword spelling, not source order, maps y to right and x to left. Only right is returned.",
      "max_depth": 3,
      "returns": {
        "x": false,
        "y": true
